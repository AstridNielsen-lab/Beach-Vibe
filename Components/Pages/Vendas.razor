@page "/vendas"
@using AdmBeachApp.Services
@using AdmBeachApp.Models
@inject IProdutoService ProdutoService
@inject IVendaService VendaService
@inject IJSRuntime JSRuntime

<PageTitle>Vendas - AdmBeachApp</PageTitle>

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <h1 class="display-5">
                    <i class="bi bi-cart-check text-success"></i>
                    Gestão de Vendas
                </h1>
                <button class="btn btn-success" @onclick="AbrirModalNovaVenda">
                    <i class="bi bi-plus-circle"></i>
                    Nova Venda
                </button>
            </div>
        </div>
    </div>
    
    <!-- Filtros -->
    <div class="row mb-3">
        <div class="col-md-4">
            <label class="form-label">Data Início:</label>
            <input type="date" class="form-control" @bind="dataInicio" @bind:after="FiltrarVendas" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Data Fim:</label>
            <input type="date" class="form-control" @bind="dataFim" @bind:after="FiltrarVendas" />
        </div>
        <div class="col-md-4">
            <div class="d-flex align-items-end">
                <button class="btn btn-outline-primary" @onclick="CarregarVendasHoje">
                    <i class="bi bi-calendar-day"></i>
                    Hoje
                </button>
            </div>
        </div>
    </div>
    
    <!-- Resumo -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card bg-success text-white">
                <div class="card-body text-center">
                    <h5>Total de Vendas</h5>
                    <h3>@vendas.Sum(v => v.Total).ToString("C")</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-info text-white">
                <div class="card-body text-center">
                    <h5>Quantidade de Vendas</h5>
                    <h3>@vendas.Count</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-warning text-white">
                <div class="card-body text-center">
                    <h5>Ticket Médio</h5>
                    <h3>@(vendas.Any() ? (vendas.Sum(v => v.Total) / vendas.Count).ToString("C") : "R$ 0,00")</h3>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Lista de Vendas -->
    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">Vendas Realizadas</h5>
        </div>
        <div class="card-body">
            @if (vendas.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Data/Hora</th>
                                <th>Cliente</th>
                                <th>Itens</th>
                                <th>Método Pagamento</th>
                                <th>Total</th>
                                <th>Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var venda in vendas.OrderByDescending(v => v.DataVenda))
                            {
                                <tr>
                                    <td><strong>#@venda.Id</strong></td>
                                    <td>@venda.DataVenda.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@(venda.ClienteNome ?? "Não informado")</td>
                                    <td>
                                        <span class="badge bg-secondary">@venda.QuantidadeTotalItens itens</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-info">@venda.MetodoPagamento</span>
                                    </td>
                                    <td><strong class="text-success">@venda.Total.ToString("C")</strong></td>
                                    <td>
                                        <button class="btn btn-outline-primary btn-sm" 
                                                @onclick="() => VisualizarVenda(venda)">
                                            <i class="bi bi-eye"></i>
                                            Ver Detalhes
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info text-center">
                    <i class="bi bi-info-circle"></i>
                    Nenhuma venda encontrada no período selecionado.
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal Nova Venda -->
@if (mostrarModalNovaVenda)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-plus-circle"></i>
                        Nova Venda
                    </h5>
                    <button type="button" class="btn-close" @onclick="FecharModalNovaVenda"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="novaVenda" OnValidSubmit="SalvarVenda">
                        <DataAnnotationsValidator />
                        
                        <!-- Informações da Venda -->
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label">Nome do Cliente:</label>
                                <InputText class="form-control" @bind-Value="novaVenda.ClienteNome" placeholder="Opcional" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Método de Pagamento:</label>
                                <InputSelect class="form-select" @bind-Value="novaVenda.MetodoPagamento">
                                    <option value="Dinheiro">Dinheiro</option>
                                    <option value="Cartão de Débito">Cartão de Débito</option>
                                    <option value="Cartão de Crédito">Cartão de Crédito</option>
                                    <option value="PIX">PIX</option>
                                </InputSelect>
                            </div>
                        </div>
                        
                        <!-- Adicionar Produtos -->
                        <div class="card mb-3">
                            <div class="card-header">
                                <h6 class="mb-0">Adicionar Produtos</h6>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-6">
                                        <label class="form-label">Produto:</label>
                                        <select class="form-select" @bind="produtoSelecionadoId">
                                            <option value="0">Selecione um produto...</option>
                                            @foreach (var produto in produtosDisponiveis)
                                            {
                                                <option value="@produto.Id">@produto.Nome - @produto.Preco.ToString("C")</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label">Quantidade:</label>
                                        <input type="number" class="form-control" @bind="quantidadeProduto" min="1" />
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label">&nbsp;</label>
                                        <button type="button" class="btn btn-success d-block" @onclick="AdicionarProduto">
                                            <i class="bi bi-plus"></i>
                                            Adicionar
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Itens da Venda -->
                        <div class="card mb-3">
                            <div class="card-header">
                                <h6 class="mb-0">Itens da Venda</h6>
                            </div>
                            <div class="card-body">
                                @if (novaVenda.Itens.Any())
                                {
                                    <div class="table-responsive">
                                        <table class="table table-sm">
                                            <thead>
                                                <tr>
                                                    <th>Produto</th>
                                                    <th>Preço Unit.</th>
                                                    <th>Qtd</th>
                                                    <th>Subtotal</th>
                                                    <th>Ação</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in novaVenda.Itens)
                                                {
                                                    <tr>
                                                        <td>@(produtosDisponiveis.FirstOrDefault(p => p.Id == item.ProdutoId)?.Nome)</td>
                                                        <td>@item.PrecoUnitario.ToString("C")</td>
                                                        <td>@item.Quantidade</td>
                                                        <td><strong>@item.Subtotal.ToString("C")</strong></td>
                                                        <td>
                                                            <button type="button" class="btn btn-outline-danger btn-sm" 
                                                                    @onclick="() => RemoverItem(item)">
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                            <tfoot>
                                                <tr>
                                                    <th colspan="3">Total:</th>
                                                    <th><h5 class="text-success mb-0">@novaVenda.Itens.Sum(i => i.Subtotal).ToString("C")</h5></th>
                                                    <th></th>
                                                </tr>
                                            </tfoot>
                                        </table>
                                    </div>
                                }
                                else
                                {
                                    <p class="text-muted text-center">Nenhum item adicionado ainda.</p>
                                }
                            </div>
                        </div>
                        
                        <!-- Observações -->
                        <div class="mb-3">
                            <label class="form-label">Observações:</label>
                            <InputTextArea class="form-control" @bind-Value="novaVenda.Observacoes" rows="2" placeholder="Observações opcionais..." />
                        </div>
                        
                        <div class="d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-secondary" @onclick="FecharModalNovaVenda">
                                Cancelar
                            </button>
                            <button type="submit" class="btn btn-success" disabled="@(!novaVenda.Itens.Any())">
                                <i class="bi bi-check-circle"></i>
                                Finalizar Venda
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal Detalhes da Venda -->
@if (mostrarModalDetalhes && vendaSelecionada != null)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-receipt"></i>
                        Detalhes da Venda #@vendaSelecionada.Id
                    </h5>
                    <button type="button" class="btn-close" @onclick="FecharModalDetalhes"></button>
                </div>
                <div class="modal-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <strong>Data/Hora:</strong><br>
                            @vendaSelecionada.DataVenda.ToString("dd/MM/yyyy HH:mm")
                        </div>
                        <div class="col-md-6">
                            <strong>Cliente:</strong><br>
                            @(vendaSelecionada.ClienteNome ?? "Não informado")
                        </div>
                    </div>
                    
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <strong>Método de Pagamento:</strong><br>
                            @vendaSelecionada.MetodoPagamento
                        </div>
                        <div class="col-md-6">
                            <strong>Total:</strong><br>
                            <h4 class="text-success">@vendaSelecionada.Total.ToString("C")</h4>
                        </div>
                    </div>
                    
                    @if (!string.IsNullOrEmpty(vendaSelecionada.Observacoes))
                    {
                        <div class="mb-3">
                            <strong>Observações:</strong><br>
                            @vendaSelecionada.Observacoes
                        </div>
                    }
                    
                    <h6>Itens da Venda:</h6>
                    <div class="table-responsive">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Produto</th>
                                    <th>Preço Unit.</th>
                                    <th>Quantidade</th>
                                    <th>Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in vendaSelecionada.Itens)
                                {
                                    <tr>
                                        <td>@item.Produto?.Nome</td>
                                        <td>@item.PrecoUnitario.ToString("C")</td>
                                        <td>@item.Quantidade</td>
                                        <td><strong>@item.Subtotal.ToString("C")</strong></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="FecharModalDetalhes">Fechar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Venda> vendas = new();
    private List<Produto> produtosDisponiveis = new();
    private DateTime dataInicio = DateTime.Today;
    private DateTime dataFim = DateTime.Today;
    
    // Modal Nova Venda
    private bool mostrarModalNovaVenda = false;
    private Venda novaVenda = new();
    private int produtoSelecionadoId = 0;
    private int quantidadeProduto = 1;
    
    // Modal Detalhes
    private bool mostrarModalDetalhes = false;
    private Venda? vendaSelecionada = null;
    
    protected override async Task OnInitializedAsync()
    {
        await CarregarDados();
        await CarregarVendasHoje();
    }
    
    private async Task CarregarDados()
    {
        try
        {
            produtosDisponiveis = await ProdutoService.GetProdutosAsync();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Erro ao carregar dados: {ex.Message}");
        }
    }
    
    private async Task CarregarVendasHoje()
    {
        dataInicio = DateTime.Today;
        dataFim = DateTime.Today;
        await FiltrarVendas();
    }
    
    private async Task FiltrarVendas()
    {
        try
        {
            vendas = await VendaService.GetVendasPorPeriodoAsync(dataInicio, dataFim);
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Erro ao carregar vendas: {ex.Message}");
        }
    }
    
    private void AbrirModalNovaVenda()
    {
        novaVenda = new Venda();
        produtoSelecionadoId = 0;
        quantidadeProduto = 1;
        mostrarModalNovaVenda = true;
    }
    
    private void FecharModalNovaVenda()
    {
        mostrarModalNovaVenda = false;
        novaVenda = new();
    }
    
    private void AdicionarProduto()
    {
        if (produtoSelecionadoId > 0 && quantidadeProduto > 0)
        {
            var produto = produtosDisponiveis.FirstOrDefault(p => p.Id == produtoSelecionadoId);
            if (produto != null)
            {
                // Verificar se o produto já está na lista
                var itemExistente = novaVenda.Itens.FirstOrDefault(i => i.ProdutoId == produtoSelecionadoId);
                if (itemExistente != null)
                {
                    itemExistente.Quantidade += quantidadeProduto;
                }
                else
                {
                    var novoItem = new ItemVenda
                    {
                        ProdutoId = produto.Id,
                        Produto = produto,
                        Quantidade = quantidadeProduto,
                        PrecoUnitario = produto.Preco
                    };
                    novaVenda.Itens.Add(novoItem);
                }
                
                produtoSelecionadoId = 0;
                quantidadeProduto = 1;
            }
        }
    }
    
    private void RemoverItem(ItemVenda item)
    {
        novaVenda.Itens.Remove(item);
    }
    
    private async Task SalvarVenda()
    {
        try
        {
            if (!novaVenda.Itens.Any())
            {
                await JSRuntime.InvokeVoidAsync("alert", "Adicione pelo menos um item à venda!");
                return;
            }
            
            await VendaService.CreateVendaAsync(novaVenda);
            FecharModalNovaVenda();
            await FiltrarVendas();
            await JSRuntime.InvokeVoidAsync("alert", "Venda realizada com sucesso!");
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Erro ao realizar venda: {ex.Message}");
        }
    }
    
    private async Task VisualizarVenda(Venda venda)
    {
        try
        {
            vendaSelecionada = await VendaService.GetVendaByIdAsync(venda.Id);
            mostrarModalDetalhes = true;
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Erro ao carregar detalhes da venda: {ex.Message}");
        }
    }
    
    private void FecharModalDetalhes()
    {
        mostrarModalDetalhes = false;
        vendaSelecionada = null;
    }
}

