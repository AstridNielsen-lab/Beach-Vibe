@page "/login"
@using AdmBeachApp.Services
@using Supabase.Gotrue
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject ILogger<Login> Logger

<div class="login-container">
    <div class="login-card">
        <div class="login-header">
            <h2>🏖️ Beach Vibe Admin</h2>
            <p>Faça login para acessar o sistema</p>
        </div>

        @if (isLoading)
        {
            <div class="loading-section">
                <div class="spinner"></div>
                <p>Conectando...</p>
            </div>
        }
        else if (errorMessage != null)
        {
            <div class="error-message">
                <i class="error-icon">⚠️</i>
                <p>@errorMessage</p>
                <button class="retry-button" @onclick="ClearError">Tentar Novamente</button>
            </div>
        }
        else
        {
            <div class="login-content">
                <div class="welcome-message">
                    <p>Bem-vindo ao sistema administrativo da Beach Vibe!</p>
                    <p class="subtitle">Gerencie produtos, pedidos e vendas de forma simples e eficiente.</p>
                </div>

                <button class="google-login-button" @onclick="LoginWithGoogle" disabled="@isLoading">
                    <svg class="google-icon" viewBox="0 0 24 24">
                        <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                        <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                        <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                        <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                    </svg>
                    Entrar com Google
                </button>

                <div class="features">
                    <h4>Recursos disponíveis:</h4>
                    <ul>
                        <li>🛍️ Gerenciamento de produtos</li>
                        <li>📋 Controle de pedidos</li>
                        <li>📊 Relatórios de vendas</li>
                        <li>📱 Sincronização em tempo real</li>
                    </ul>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .login-container {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        padding: 20px;
    }

    .login-card {
        background: white;
        border-radius: 16px;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
        padding: 40px;
        width: 100%;
        max-width: 450px;
        text-align: center;
    }

    .login-header h2 {
        color: #333;
        margin-bottom: 8px;
        font-size: 28px;
        font-weight: 600;
    }

    .login-header p {
        color: #666;
        margin-bottom: 32px;
        font-size: 16px;
    }

    .welcome-message {
        margin-bottom: 32px;
    }

    .welcome-message p {
        color: #444;
        line-height: 1.6;
        margin-bottom: 12px;
    }

    .subtitle {
        font-size: 14px !important;
        color: #666 !important;
    }

    .google-login-button {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        background: white;
        border: 2px solid #ddd;
        color: #333;
        padding: 16px 24px;
        border-radius: 50px;
        font-size: 16px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.3s ease;
        width: 100%;
        margin-bottom: 32px;
    }

    .google-login-button:hover {
        border-color: #4285F4;
        box-shadow: 0 4px 12px rgba(66, 133, 244, 0.15);
        transform: translateY(-1px);
    }

    .google-login-button:disabled {
        opacity: 0.6;
        cursor: not-allowed;
        transform: none;
    }

    .google-icon {
        width: 20px;
        height: 20px;
    }

    .loading-section {
        padding: 40px 20px;
    }

    .spinner {
        width: 40px;
        height: 40px;
        border: 4px solid #f0f0f0;
        border-top: 4px solid #4285F4;
        border-radius: 50%;
        animation: spin 1s linear infinite;
        margin: 0 auto 20px;
    }

    .error-message {
        padding: 20px;
        background: #fef5f5;
        border: 1px solid #fed7d7;
        border-radius: 12px;
        margin-bottom: 24px;
    }

    .error-message p {
        color: #e53e3e;
        margin: 8px 0;
    }

    .error-icon {
        font-size: 24px;
        margin-bottom: 8px;
        display: block;
    }

    .retry-button {
        background: #e53e3e;
        color: white;
        border: none;
        padding: 8px 16px;
        border-radius: 6px;
        cursor: pointer;
        margin-top: 12px;
    }

    .features {
        background: #f8f9fa;
        padding: 24px;
        border-radius: 12px;
        text-align: left;
    }

    .features h4 {
        color: #333;
        margin-bottom: 16px;
        font-size: 16px;
        text-align: center;
    }

    .features ul {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .features li {
        padding: 8px 0;
        color: #555;
        font-size: 14px;
    }

    @@keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }

    @@media (max-width: 768px) {
        .login-card {
            padding: 24px;
            margin: 16px;
        }
        
        .login-header h2 {
            font-size: 24px;
        }
        
        .google-login-button {
            padding: 14px 20px;
            font-size: 14px;
        }
    }
</style>

@code {
    private bool isLoading = false;
    private string? errorMessage = null;

    protected override async Task OnInitializedAsync()
    {
        // Verificar se o usuário já está logado
        var isLoggedIn = await AuthService.IsLoggedInAsync();
        if (isLoggedIn)
        {
            Navigation.NavigateTo("/", replace: true);
        }
    }

    private async Task LoginWithGoogle()
    {
        try
        {
            isLoading = true;
            errorMessage = null;
            StateHasChanged();

            Logger.LogInformation("Tentativa de login com Google iniciada");

            var user = await AuthService.LoginWithGoogleAsync();
            
            if (user != null)
            {
                Logger.LogInformation($"Login bem-sucedido: {user.Email}");
                Navigation.NavigateTo("/", replace: true);
            }
            else
            {
                errorMessage = "Falha no login. Tente novamente.";
                Logger.LogWarning("Login retornou usuário nulo");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Erro durante o login");
            errorMessage = "Erro durante o login. Verifique sua conexão e tente novamente.";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void ClearError()
    {
        errorMessage = null;
        StateHasChanged();
    }
}
