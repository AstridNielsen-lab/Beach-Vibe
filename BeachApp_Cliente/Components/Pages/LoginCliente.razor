@code {
    private string nomeOuCpf = string.Empty;
    private string telefone = string.Empty;
    private string mesa = string.Empty;
    private bool isLoading = false;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        // Verificar se o cliente jÃ¡ estÃ¡ logado
        var isLoggedIn = await ClientAuthService.IsLoggedInAsync();
        if (isLoggedIn)
        {
            Navigation.NavigateTo("/", replace: true);
        }
    }

    private async Task HandleLogin()
    {
        try
        {
            isLoading = true;
            errorMessage = string.Empty;
            StateHasChanged();

            Logger.LogInformation($"Tentativa de login do cliente: {nomeOuCpf}");

            var cliente = await ClientAuthService.LoginAsync(nomeOuCpf.Trim(), telefone.Trim());
            
            if (cliente != null)
            {
                // Se forneceu mesa, vamos salvar isso no cliente
                if (!string.IsNullOrWhiteSpace(mesa))
                {
                    cliente.Mesa = mesa.Trim();
                }

                Logger.LogInformation($"Login bem-sucedido: {cliente.Nome}");
                Navigation.NavigateTo("/", replace: true);
            }
            else
            {
                errorMessage = "NÃ£o foi possÃ­vel realizar o login. Tente novamente.";
            }
        }
        catch (ArgumentException ex)
        {
            errorMessage = ex.Message;
            Logger.LogWarning($"Erro de validaÃ§Ã£o no login: {ex.Message}");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Erro durante o login do cliente");
            errorMessage = "Erro interno. Tente novamente em alguns instantes.";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void ClearError()
    {
        errorMessage = string.Empty;
        StateHasChanged();
    }
}


