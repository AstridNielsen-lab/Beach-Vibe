@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string RedirectTo { get; set; } = "/login";
    [Parameter] public bool RequireAuthentication { get; set; } = true;

    private bool isLoading = true;
    private bool isAuthenticated = false;
    private ClienteInfo? currentCliente;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Logger.LogDebug("ClientAuthGuard: Verificando estado de autenticaÃ§Ã£o");

            // Verificar se hÃ¡ um cliente logado
            currentCliente = await ClientAuthService.GetCurrentClienteAsync();
            isAuthenticated = currentCliente != null;

            Logger.LogDebug($"ClientAuthGuard: Cliente autenticado: {isAuthenticated}");

            // Se nÃ£o autenticado e requer autenticaÃ§Ã£o, redirecionar
            if (RequireAuthentication && !isAuthenticated)
            {
                Logger.LogInformation("ClientAuthGuard: Cliente nÃ£o autenticado, redirecionando para login");
                
                // Pequeno delay para mostrar a mensagem antes de redirecionar
                await Task.Delay(1500);
                Navigation.NavigateTo(RedirectTo, replace: true);
                return;
            }

            // Inscrever-se nas mudanÃ§as de autenticaÃ§Ã£o
            ClientAuthService.AuthStateChanged += OnAuthStateChanged;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "ClientAuthGuard: Erro ao verificar autenticaÃ§Ã£o");
            
            if (RequireAuthentication)
            {
                await Task.Delay(1000);
                Navigation.NavigateTo(RedirectTo, replace: true);
            }
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void OnAuthStateChanged(ClienteInfo? cliente)
    {
        var wasAuthenticated = isAuthenticated;
        currentCliente = cliente;
        isAuthenticated = cliente != null;

        Logger.LogDebug($"ClientAuthGuard: Estado de autenticaÃ§Ã£o alterado. Autenticado: {isAuthenticated}");

        // Se o cliente foi deslogado e a pÃ¡gina requer autenticaÃ§Ã£o
        if (RequireAuthentication && wasAuthenticated && !isAuthenticated)
        {
            Logger.LogInformation("ClientAuthGuard: Cliente deslogado, redirecionando para login");
            Navigation.NavigateTo(RedirectTo, replace: true);
        }

        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ClientAuthService.AuthStateChanged -= OnAuthStateChanged;
    }
}


